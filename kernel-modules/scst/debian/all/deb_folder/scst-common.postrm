set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for unit in scst-ctl-dev.service; do
        deb-systemd-helper disable "$unit" >/dev/null 2>&1 || true
    done
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#

exit 0
