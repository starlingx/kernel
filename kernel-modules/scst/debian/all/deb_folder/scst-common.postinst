set -e

if [ "$1" = "configure" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    for unit in scst-ctl-dev.service; do
        deb-systemd-helper enable "$unit" >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl start "$unit" >/dev/null 2>&1 || true
        fi
    done
fi

#DEBHELPER#

exit 0
