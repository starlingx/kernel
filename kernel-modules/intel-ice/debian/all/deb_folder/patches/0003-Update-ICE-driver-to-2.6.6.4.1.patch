diff --git a/src/ice_debugfs.c b/src/ice_debugfs.c
index dacc5d0..3f0ad7a 100644
--- a/src/ice_debugfs.c
+++ b/src/ice_debugfs.c
@@ -1431,6 +1431,69 @@ ice_debugfs_command_write(struct file *file, const char __user *buf,
 		} else {
 			goto command_help;
 		}
+	} else if (argc == 1 && !strncmp(argv[0], "trigger_phy_soft_reset", 22)) {
+		struct ice_ptp_port *ptp_port = &pf->ptp.port;
+
+		if (hw->mac_type != ICE_MAC_GENERIC_3K_E825 ||
+		    pf->ptp.state != ICE_PTP_READY)
+			goto command_help;
+
+		dev_warn_ratelimited(dev, "Initiating manual PHY soft reset on port %d\n",
+				     ptp_port->port_num);
+
+		ice_port_perform_phy_soft_reset(pf, ptp_port->port_num, ptp_port);
+	} else if ((argc == 1 || argc == 2) && !strncmp(argv[0], "automatic_phy_soft_reset_enable", 31)) {
+		struct ice_ptp_port *ptp_port = &pf->ptp.port;
+
+		if (hw->mac_type != ICE_MAC_GENERIC_3K_E825 ||
+		    pf->ptp.state != ICE_PTP_READY)
+			goto command_help;
+
+		if (argc == 1) {
+			dev_info(dev, "Automatic PHY soft reset for port %d is %s\n",
+				 ptp_port->port_num,
+				 str_enabled_disabled(ptp_port->phy_soft_reset_enabled));
+		} else {
+			bool enable;
+
+			ret = kstrtobool(argv[1], &enable);
+			if (ret)
+				goto command_help;
+
+			dev_info(dev, "Automatic PHY soft reset for port %d is now %s\n",
+				 ptp_port->port_num,
+				 str_enabled_disabled(enable));
+
+			ptp_port->phy_soft_reset_enabled = enable;
+		}
+	} else if ((argc == 1 || argc == 2) && !strncmp(argv[0], "automatic_phy_soft_reset_threshold", 35)) {
+		struct ice_ptp_port *ptp_port = &pf->ptp.port;
+
+		if (hw->mac_type != ICE_MAC_GENERIC_3K_E825 ||
+		    pf->ptp.state != ICE_PTP_READY)
+			goto command_help;
+
+		if (argc == 1) {
+			dev_info(dev, "Automatic PHY soft reset threshold for port %d is %u\n",
+				 ptp_port->port_num,
+				 ptp_port->phy_soft_reset_threshold);
+		} else {
+			u32 threshold;
+
+			ret = kstrtou32(argv[1], 0, &threshold);
+			if (ret)
+				goto command_help;
+
+			/* The threshold cannot be zero */
+			if (!threshold)
+				goto command_help;
+
+			dev_info(dev, "Automatic PHY soft reset threshold for port %d is now %u\n",
+				 ptp_port->port_num,
+				 threshold);
+
+			ptp_port->phy_soft_reset_threshold = threshold;
+		}
 	} else if (argc == 2 && !strncmp(argv[0], "dump", 4) &&
 		   !strncmp(argv[1], "switch", 6)) {
 		ret = ice_dump_sw_cfg(hw);
@@ -1591,6 +1654,12 @@ command_help:
 #endif /* ICE_ADD_PROBES */
 		if (ice_is_feature_supported(pf, ICE_F_PHY_RCLK))
 			dev_info(dev, "\t dump rclk_status\n");
+		if (hw->mac_type == ICE_MAC_GENERIC_3K_E825 &&
+		    pf->ptp.state == ICE_PTP_READY) {
+			dev_info(dev, "\t trigger_phy_soft_reset\n");
+			dev_info(dev, "\t automatic_phy_soft_reset_enable [0|1]\n");
