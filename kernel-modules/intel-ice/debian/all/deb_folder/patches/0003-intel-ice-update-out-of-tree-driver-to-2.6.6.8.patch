+/**
+ * ice_ptp_check_phy_interrupt_status - Check if E825C PHY interrupt is blocked
+ * @pf: Board private structure
+ *
+ * The E825C PHY timestamping block can become stuck such that no interrupts
+ * will be generated. This is known to occur due to software misconfiguration,
+ * but is suspected to possibly occur rarely during normal operation. If the
+ * PHY_PTP_INT_STATUS indicator for the port is stuck high, but the port PHY
+ * timestamp memory block is cleared, then port timestamp interrupt might be
+ * stuck.
+ *
+ * If a port appears stuck for two checks in a row, attempt to recover the
+ * timestamp block by performing a PHY soft reset for the associated port.
+ */
+static void ice_ptp_check_phy_interrupt_status(struct ice_pf *pf)
+{
+	struct device *dev = ice_pf_to_dev(pf);
+	u32 phy_ports_maybe_stuck = 0;
+	struct ice_ptp_port *ptp_port;
+	struct ice_hw *hw = &pf->hw;
+	u64 tstamp_ready;
+	u32 ts_status;
+	int err;
+
+	/* Only need to check for PHY lockup on E825-C devices */
+	if (hw->mac_type != ICE_MAC_GENERIC_3K_E825)
+		return;
+
+	err = ice_ptp_read_tx_hwtstamp_status_eth56g(hw, &ts_status);
+	if (err) {
+		dev_dbg(dev, "Failed to read PHY_PTP_INT_STATUS, err %d\n",
+			err);
+		return;
+	}
+
+	if (!ts_status)
+		return;
+
+	for (int port_num = 0; port_num < hw->ptp.num_lports; port_num++) {
+		u32 threshold;
+		bool enabled;
+		if (!(ts_status & BIT(port_num)))
+			continue;
+
+		err = ice_get_phy_tx_tstamp_ready(hw, port_num, &tstamp_ready);
+		if (err)
+			continue;
+
+		/* If the port has an active driver, it will have a PTP port
+		 * structure associated with this adapter. The hardware block
+		 * must be reset regardless, but additional steps are taken
+		 * for active ports.
+		 */
+		rcu_read_lock();
+		ptp_port = xa_load(&pf->adapter->ptp_ports, port_num);
+		if (!ptp_port || !kref_get_unless_zero(&ptp_port->ref))
+			ptp_port = NULL;
+		rcu_read_unlock();
+
+		if (ptp_port) {
+			threshold = ptp_port->phy_soft_reset_threshold;
+			enabled = ptp_port->phy_soft_reset_enabled;
+		} else {
+			/* Use the owner settings for ports which aren't
+			 * enabled in software.
+			 */
+			threshold = pf->ptp.port.phy_soft_reset_threshold;
+			enabled = pf->ptp.port.phy_soft_reset_enabled;
+		}
+
+		/* If the timestamp status bit for the PHY interrupt is read
+		 * high, and the timestamp ready bitmap is clear, the
+		 * timestamp interrupt might be stuck. When this occurs, new
+		 * interrupts cannot be generated for any port on the quad.
+		 *
+		 * For ports which are not enabled in software, there should
+		 * be no timestamps on the port and no activity. However, if
+		 * the hardware PHY interrupt becomes locked, we must still
+		 * clear the port to allow interrupts on that quad. For such
+		 * ports, immediately perform a soft reset when we detect the
+		 * locked state.
+		 *
+		 * For software-enabled ports, the detection logic may
+		 * generate false positives. This occurs because we cannot
+		 * guarantee reading the PHY interrupt status and the ready
+		 * bitmap atomically without change from hardware end.
+		 * Instead, keep track of how many consectutive stalls we
+		 * detect for the port. Once it exceeds the configured
+		 * threshold, perform a PHY soft reset and reset the count.
+		 *
+		 * Additionally, for software-enabled ports, check if we have
+		 * stalled timestamp requests. If a timestamp has been waiting
+		 * in software for too long, assume the PHY interrupt is stuck
+		 * and initiate a soft reset.
+		 *
+		 * Automatic recovery may be disabled, in which case instead
+		 * only log a warning but do not initiate the reset process.
+		 */
+		if (ptp_port && ice_ptp_has_tstamp_timeout(&ptp_port->tx)) {
+			if (enabled) {
+				dev_warn_ratelimited(dev, "Detected Tx timestamp timeouts on port %d. Attempting automatic recovery via PHY soft reset\n",
+						     port_num);
+				ice_port_perform_phy_soft_reset(pf, port_num, ptp_port);
+			} else {
+				dev_warn_ratelimited(dev, "Detected Tx timestamp timeouts on port %d, but automatic PHY soft reset is disabled.\n",
+						     port_num);
+			}
+		} else if (!tstamp_ready) {
+			if (ptp_port) {
+				ptp_port->phy_stuck_count++;
+				dev_dbg(dev, "Detected possible PHY interrupt stall %d consecutive times on port %d\n",
+					ptp_port->phy_stuck_count, port_num);
+			}
+
+			if (enabled) {
+				if (!ptp_port) {
+					dev_warn_ratelimited(dev, "Detected possible PHY interrupt stall on disabled port %d. Attempting automatic recovery via PHY soft reset\n",
+							     port_num);
+					ice_port_perform_phy_soft_reset(pf, port_num, NULL);
+				} else if (ptp_port->phy_stuck_count >= threshold) {
+					dev_warn_ratelimited(dev, "Detected possible PHY interrupt stall on port %d. Attempting automatic recovery via PHY soft reset\n",
+							     port_num);
+					ice_port_perform_phy_soft_reset(pf, port_num, ptp_port);
+				}
+			} else {
+				if (!ptp_port) {
+					dev_warn_ratelimited(dev, "Detected possible PHY interrupt stall on disabled port %d, but automatic PHY soft reset is disabled\n",
+							     port_num);
+				} else if (ptp_port->phy_stuck_count >= threshold) {
+					dev_warn_ratelimited(dev, "Detected possible PHY interrupt stall on port %d, but automatic PHY soft reset is disabled\n",
+							     port_num);
+					ptp_port->phy_stuck_count = 0;
+				}
+			}
+		} else {
+			/* Port appears to not be stuck, clear the count */
+			if (ptp_port) {
+				if (ptp_port->phy_stuck_count > 0)
+					dev_dbg(dev, "Clearing PHY stuck count on port %d with a stuck count of %d\n",
+						port_num, ptp_port->phy_stuck_count);
+				ptp_port->phy_stuck_count = 0;
+			}
+		}
+
+		if (ptp_port)
+			kref_put(&ptp_port->ref, ice_ptp_release_port_rcu);
+	}
+
+	pf->ptp.phy_ports_maybe_stuck = phy_ports_maybe_stuck;
+}
