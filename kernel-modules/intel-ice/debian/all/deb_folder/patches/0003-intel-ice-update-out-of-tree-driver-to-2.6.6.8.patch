+	unsigned int offset;
+	int type;
+
+	if (!skb || !skb_mac_header_was_set(skb))
+		return -1;
+
+	offset = skb->data - skb_mac_header(skb);
+	skb_push(skb, offset);
+
+	type = ptp_classify_raw(skb);
+
+	if (type == PTP_CLASS_NONE) {
+		skb_pull(skb, offset);
+		return -1;
+	}
+
+	hdr = ptp_parse_header(skb, type);
+	skb_pull(skb, offset);
+	if (!hdr)
+		return -1;
+
+	return be16_to_cpu(hdr->sequence_id);
